# Browser-visible configuration for search.techyst.net.
# Paste into Vercel → Settings → Environment Variables, or import with
#   vercel env add < .env.vercel
# Server secrets do not belong here; they are compiled into the bundle.
NEXT_PUBLIC_ONYX_BACKEND_URL=https://search-api.techyst.net
NEXT_PUBLIC_APP_DOMAIN=search.techyst.net
NEXT_PUBLIC_DO_NOT_USE_TOGGLE_OFF_DANSWER_POWERED=true
NEXT_PUBLIC_THEME=dark
