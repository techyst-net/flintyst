# Keep the upload small: Vercel's free tier rate-limits on file count, and
# deploying from the repo root would otherwise send the whole monorepo.
.git
node_modules
**/node_modules
.venv
**/__pycache__
*.pyc
# Anchored: a bare "build"/"dist" also matches source directories such as
# web/src/lib/build, which the app imports — excluding it breaks the build with
# a module-not-found that looks nothing like an ignore-file problem.
/dist
/build
web/dist
web/build
.next
.turbo
.vercel
docs
**/docs
*.md
!README.md
tests
**/tests
__tests__
**/__tests__
*.test.*
*.spec.*
.github
deployment
docker
*.log
.env
.env.*
